{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Local main window only. No shell, HTTP, or arbitrary filesystem plugin access.",
  "windows": ["main"],
  "permissions": [
    "core:default", "dialog:allow-open",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/b1inkie/ds-workshop-studio*" }] },
    "core:window:allow-minimize", "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close", "core:window:allow-start-dragging"
  ]
}
