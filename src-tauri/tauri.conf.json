{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workshop Studio",
  "version": "0.2.1",
  "identifier": "tools.dst.workshop-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1437",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "饥荒创意工坊 · Workshop Studio",
      "width": 1440, "height": 900, "minWidth": 1080, "minHeight": 720,
      "center": true, "backgroundColor": "#00000000",
      "transparent": true, "decorations": false, "shadow": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "resources": ["resources/steam_api.dll"],
    "icon": ["icons/workshop.ico"]
  }
}
