{
  "name": "ds-workshop-tool",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --target i686-pc-windows-msvc",
    "desktop:build": "tauri build --target i686-pc-windows-msvc --no-bundle",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --target i686-pc-windows-msvc",
    "test": "playwright test",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "package:portable": "powershell -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "package:release": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "publish:release": "powershell -ExecutionPolicy Bypass -File scripts/publish-github.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
